{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "includes": [
      "**",
      "!src/bindings/generated.ts",
      "!src/routeTree.gen.ts",
      "!fide-html-snippet.html",
      "!src/styles/chessground*.css"
    ]
  },
  "formatter": {
    "enabled": true,
    "formatWithErrors": false,
    "useEditorconfig": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120,
    "lineEnding": "lf"
  },
  "overrides": [
    {
      "includes": ["src/locales/**"],
      "formatter": {
        "lineWidth": 200
      },
      "javascript": {
        "formatter": {
          "quoteProperties": "preserve"
        }
      }
    }
  ],
  "linter": {
    "rules": {
      "style": {
        "noNonNullAssertion": "warn"
      },
      "correctness": {
        "useExhaustiveDependencies": "warn"
      },
      "suspicious": {
        "noArrayIndexKey": "warn",
        "noExplicitAny": "warn",
        "noConfusingVoidType": "off"
      }
    }
  },
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true,
    "defaultBranch": "main"
  }
}
