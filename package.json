{
  "name": "obsidian-chess-studio",
  "version": "2.6.20",
  "type": "module",
  "packageManager": "pnpm@10.27.0",
  "scripts": {
    "start-vite": "vite",
    "build-vite": "tsc --noEmit && vite build",
    "build": "tauri build --no-bundle",
    "dev": "node scripts/tauri.mjs dev",
    "android:build": "tauri android build",
    "android:dev": "node scripts/tauri.mjs android dev",
    "tauri": "node scripts/tauri.mjs",
    "format": "biome format --write ./src",
    "test": "vitest run",
    "lint": "tsc --noEmit && biome check ./src",
    "lint:ci": "tsc --noEmit && biome ci ./src --diagnostic-level=error",
    "lint:fix": "npx @biomejs/biome check --write src",
    "update-readme": "npx tsx scripts/update-readme.ts",
    "update-coverage": "npx tsx scripts/update-coverage.ts",
    "update-missing-translations": "npx tsx scripts/update-missing-translations.ts",
    "merge-missing-translations": "node scripts/merge-missing-translations.cjs",
    "update-version": "node scripts/update-version.cjs",
    "knip": "knip"
  },
